{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-filter.dev/schema/v1.json",
  "title": "mcp-filter rules",
  "type": "object",
  "required": ["mcpServers"],
  "properties": {
    "$schema": { "type": "string" },
    "logging": {
      "type": "object",
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "level": { "enum": ["error", "warn", "info", "debug"] },
        "format": { "enum": ["text", "json"] }
      },
      "additionalProperties": false
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metadata": {
          "type": "object",
          "properties": {
            "server": { "type": "object" },
            "tools": { "type": "object", "additionalProperties": { "type": "object" } },
            "patches": { "type": "array" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
