{
  "mcpServers": {
    "tracker": {
      "command": "mcp-filter",
      "args": [
        "tracker",
        "--",
        "npx", "-y", "@acme/tracker-mcp"
      ]
    },
    "remote-docs": {
      "command": "mcp-filter",
      "args": [
        "remote-docs",
        "--url", "https://mcp.example.com/mcp",
        "--header-env", "Authorization=REMOTE_DOCS_TOKEN"
      ],
      "env": {
        "REMOTE_DOCS_TOKEN": "Bearer replace-me"
      }
    },
    "legacy-events": {
      "command": "mcp-filter",
      "args": [
        "legacy-events",
        "--transport", "sse",
        "--url", "https://events.example.com/sse"
      ]
    }
  }
}
