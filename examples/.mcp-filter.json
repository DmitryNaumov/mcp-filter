{
  "mcpServers": {
    "tracker": {
      "allow": ["get_issue", "search_issues"],
      "deny": ["delete_issue"],
      "metadata": {
        "server": {
          "title": "Project tracker",
          "instructions": "Use issue keys from this repository."
        },
        "tools": {
          "get_issue": {
            "description": "Read an issue before changing related code.",
            "annotations": { "readOnlyHint": true }
          }
        }
      }
    },
    "remote-docs": {
      "allow": ["search_docs"]
    },
    "legacy-events": {
      "allow": ["get_events"]
    }
  }
}
